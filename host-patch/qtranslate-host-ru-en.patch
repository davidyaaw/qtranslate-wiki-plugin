+    /**
+     * Tries the preferred edition, then the dictionary's other switch languages.
+     *
+     * A language with no article is not a failed lookup: the reader asked what the word means,
+     * and an edition that has nothing to say about it is simply skipped. The first edition with
+     * entries wins, and its language is returned so the switch can show which one is on screen.
+     * Errors are tried past for the same reason, but if every edition fails the first error is
+     * reported rather than being disguised as "not found".
+     */
+    private suspend fun lookupAcrossLanguages(
+        dictionary: Dictionary,
+        languageSwitch: LanguageSwitchDictionary,
+        word: String,
+        preferred: LanguageCode
+    ): LocatedLookup {
+        val languages = buildList {
+            add(preferred)
+            languageSwitch.switchLanguages.filterTo(this) { it != preferred }
+        }
+
+        var sawSuccess = false
+        var firstError: ServiceError? = null
+        var suggestionResult: LocatedLookup? = null
+
+        for (language in languages) {
+            val response = dictionary.lookup(DictionaryRequest(word, language))
+            var answered = false
+            response.fold(
+                success = { body ->
+                    sawSuccess = true
+                    if (body.entries.isNotEmpty()) {
+                        if (body.entries.all { it.partOfSpeech == DID_YOU_MEAN_PART_OF_SPEECH }) {
+                            // A "did you mean" entry is not an answer: another edition may have
+                            // the article. Keep it only if no edition has a real article.
+                            if (suggestionResult == null) {
+                                suggestionResult = LocatedLookup(response, language)
+                            }
+                        } else {
+                            answered = true
+                        }
+                    }
+                },
+                failure = { error ->
+                    if (firstError == null) firstError = error
+                }
+            )
+            if (answered) return LocatedLookup(response, language)
+        }
+
+        suggestionResult?.let { return it }
+        return if (sawSuccess || firstError == null) {
+            LocatedLookup(Ok(DictionaryResponse(emptyList())), preferred)
+        } else {
+            LocatedLookup(Err(firstError!!), preferred)
+        }
+    }
+
+    /**
+     * The edition a lookup should start from.
+     *
+     * A reader picking a language in the switch is always obeyed. Otherwise the word's script is
+     * the strongest signal: a Cyrillic word opens the Russian article, a Latin word the English
+     * one. This is what makes selecting Russian text work even when the translation pair (or a
+     * failed detection) says English. Other scripts fall back to the requested language, then to
+     * the dictionary's first offered edition.
+     */
+    private fun resolveLookupLanguage(
+        word: String,
+        requested: LanguageCode,
+        dictionary: LanguageSwitchDictionary?,
+        explicit: Boolean
+    ): LanguageCode {
+        val offered = dictionary?.switchLanguages.orEmpty()
+        if (offered.isEmpty()) return requested
+        if (explicit && requested in offered) return requested
+
+        var cyrillic = 0
+        var latin = 0
+        for (character in word) {
+            when (Character.UnicodeScript.of(character.code)) {
+                Character.UnicodeScript.CYRILLIC -> cyrillic++
+                Character.UnicodeScript.LATIN -> latin++
+                else -> Unit
+            }
+        }
+
+        val byScript = when {
+            cyrillic > 0 && cyrillic >= latin && LanguageCode.RUSSIAN in offered -> LanguageCode.RUSSIAN
+            latin > 0 && latin > cyrillic && LanguageCode.ENGLISH in offered -> LanguageCode.ENGLISH
+            else -> null
+        }
+        return byScript ?: requested.takeIf { it in offered } ?: offered.first()
+    }
+
+    private data class LocatedLookup(
+        val response: Result<DictionaryResponse, ServiceError>,
+        val language: LanguageCode
+    )
+
+    private companion object {
+        /** Must match the marker the Wikipedia plugin emits; see WikipediaService. */
+        const val DID_YOU_MEAN_PART_OF_SPEECH = "did_you_mean"
+    }
 }
