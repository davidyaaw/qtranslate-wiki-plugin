+++ b/ui-swing/src/main/kotlin/com/github/ahatem/qtranslate/ui/swing/dictionary/DictionaryLanguageSwitch.kt
@@ -0,0 +1,82 @@
+package com.github.ahatem.qtranslate.ui.swing.dictionary
+
+import com.github.ahatem.qtranslate.api.language.LanguageCode
+import com.github.ahatem.qtranslate.core.localization.getDisplayName
+import java.awt.FlowLayout
+import java.awt.Insets
+import javax.swing.ButtonGroup
+import javax.swing.JPanel
+import javax.swing.JToggleButton
+
+/**
+ * A compact switch between the editions a dictionary offers for one headword.
+ *
+ * Buttons are rebuilt only when the offered editions change, so a stream of lookup state
+ * emissions moves the selection without dropping and recreating the controls under the pointer.
+ * An empty offer hides the whole strip, which is what every non-switching dictionary sees.
+ */
+internal class DictionaryLanguageSwitch(
+    private val onLanguageSelected: (LanguageCode) -> Unit
+) : JPanel(FlowLayout(FlowLayout.TRAILING, 2, 0)) {
+
+    private var offered: List<LanguageCode> = emptyList()
+    private var tooltipFormat: String = ""
+    private val buttons = linkedMapOf<LanguageCode, JToggleButton>()
+    private var updating = false
+
+    init {
+        isOpaque = false
+        isVisible = false
+    }
+
+    fun render(languages: List<LanguageCode>, selected: LanguageCode?, tooltipFormat: String) {
+        if (languages != offered || tooltipFormat != this.tooltipFormat) {
+            rebuild(languages, tooltipFormat)
+        }
+        updating = true
+        try {
+            buttons.forEach { (language, button) ->
+                button.isSelected = language == selected
+                // The model change repaints the button, but the sibling that just lost the
+                // selection can keep its old pressed fill until the parent is painted. Force
+                // both so the visible highlight always matches the article on screen.
+                button.repaint()
+            }
+        } finally {
+            updating = false
+        }
+        isVisible = languages.size > 1
+        repaint()
+    }
+
+    private fun rebuild(languages: List<LanguageCode>, format: String) {
+        offered = languages
+        tooltipFormat = format
+        buttons.clear()
+        removeAll()
+
+        val group = ButtonGroup()
+        languages.forEach { language ->
+            val button = JToggleButton(language.tag.substringBefore('-').uppercase()).apply {
+                putClientProperty("JButton.buttonType", "toolBarButton")
+                margin = Insets(3, 8, 3, 8)
+                toolTipText = tooltipFor(language, format)
+                accessibleContext.accessibleName = toolTipText
+                addActionListener {
+                    if (!updating && isSelected) onLanguageSelected(language)
+                }
+            }
+            group.add(button)
+            buttons[language] = button
+            add(button)
+        }
+        revalidate()
+        repaint()
+    }
+
+    private fun tooltipFor(language: LanguageCode, format: String): String {
+        val name = language.getDisplayName()
+        if (format.isBlank()) return name
+        return runCatching { String.format(format, name) }.getOrDefault(name)
+    }
+}
