+package com.github.ahatem.qtranslate.ui.swing.dictionary
+
+import com.github.ahatem.qtranslate.api.language.LanguageCode
+import javax.swing.JToggleButton
+import kotlin.test.Test
+import kotlin.test.assertEquals
+import kotlin.test.assertFalse
+import kotlin.test.assertTrue
+
+class DictionaryLanguageSwitchTest {
+
+    @Test
+    fun `one button per offered edition, with the current edition selected`() {
+        val picked = mutableListOf<LanguageCode>()
+        val switch = DictionaryLanguageSwitch { picked += it }
+
+        switch.render(
+            languages = listOf(LanguageCode.RUSSIAN, LanguageCode.ENGLISH),
+            selected = LanguageCode.RUSSIAN,
+            tooltipFormat = "Look up in %s"
+        )
+
+        val buttons = switch.components.filterIsInstance<JToggleButton>()
+        assertEquals(listOf("RU", "EN"), buttons.map { it.text })
+        assertTrue(buttons[0].isSelected)
+        assertFalse(buttons[1].isSelected)
+        assertTrue(switch.isVisible)
+    }
+
+    @Test
+    fun `choosing another edition reports it once`() {
+        val picked = mutableListOf<LanguageCode>()
+        val switch = DictionaryLanguageSwitch { picked += it }
+        switch.render(
+            languages = listOf(LanguageCode.RUSSIAN, LanguageCode.ENGLISH),
+            selected = LanguageCode.RUSSIAN,
+            tooltipFormat = "Look up in %s"
+        )
+
+        switch.components.filterIsInstance<JToggleButton>()[1].doClick()
+
+        assertEquals(listOf(LanguageCode.ENGLISH), picked)
+    }
+
+    @Test
+    fun `changing the shown edition moves the selection without rebuilding`() {
+        val switch = DictionaryLanguageSwitch { }
+        switch.render(
+            languages = listOf(LanguageCode.RUSSIAN, LanguageCode.ENGLISH),
+            selected = LanguageCode.RUSSIAN,
+            tooltipFormat = "Look up in %s"
+        )
+        val buttonsBefore = switch.components.filterIsInstance<JToggleButton>()
+
+        switch.render(
+            languages = listOf(LanguageCode.RUSSIAN, LanguageCode.ENGLISH),
+            selected = LanguageCode.ENGLISH,
+            tooltipFormat = "Look up in %s"
+        )
+
+        val buttonsAfter = switch.components.filterIsInstance<JToggleButton>()
+        assertEquals(buttonsBefore, buttonsAfter)
+        assertFalse(buttonsAfter[0].isSelected)
+        assertTrue(buttonsAfter[1].isSelected)
+    }
+
+    @Test
+    fun `a dictionary with one edition shows no switch`() {
+        val switch = DictionaryLanguageSwitch { }
+        switch.render(
+            languages = listOf(LanguageCode.RUSSIAN),
+            selected = LanguageCode.RUSSIAN,
+            tooltipFormat = "Look up in %s"
+        )
+
+        assertFalse(switch.isVisible)
+    }
+}
