+
+/** A clipboard whose only entry is an image whose owner has already released its data. */
+private class DeadClipboard : SystemClipboard {
+    var cleared = false
+    var text: String? = null
+    var restoreCount = 0
+
+    override fun snapshot(): ClipboardSnapshotResult =
+        if (cleared) {
+            ClipboardSnapshotResult.Empty
+        } else {
+            ClipboardSnapshotResult.Failed(
+                IOException(
+                    "Exception fetching data: ",
+                    IOException("system clipboard data unavailable")
+                )
+            )
+        }
+
+    override fun readText(): String? = text
+
+    override fun signature(): Long? = if (cleared) 1L else null
+
+    override fun restore(state: ClipboardSnapshotResult) {
+        restoreCount++
+        if (state is ClipboardSnapshotResult.Empty) {
+            cleared = true
+            text = null
+        }
+    }
+}
