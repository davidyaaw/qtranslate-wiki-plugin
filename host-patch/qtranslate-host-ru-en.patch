+package com.github.ahatem.qtranslate.api.dictionary
+
+import com.github.ahatem.qtranslate.api.language.LanguageCode
+
+/**
+ * Optional behaviour for dictionaries that can present the same headword in more than one
+ * language and let the reader choose which edition to read.
+ *
+ * The host shows one control per language in [switchLanguages] and asks for a lookup with
+ * [DictionaryRequest.language] set to the chosen language. A dictionary that does not implement
+ * this interface keeps the original single-language behaviour exactly as before.
+ *
+ * The list is deliberately small: it is the set of editions worth offering for a word, not the
+ * complete set of languages the service supports. Wikipedia, for example, supports dozens of
+ * editions but a reader looking up a word usually wants the one matching its script and, failing
+ * that, the English one.
+ */
+public interface LanguageSwitchDictionary : Dictionary {
+
+    /**
+     * Languages offered by the switch, in display order.
+     *
+     * Must not be empty and must not contain [LanguageCode.AUTO]: every entry names a concrete
+     * edition whose lookup can be requested directly.
+     */
+    public val switchLanguages: List<LanguageCode>
+}
