+package com.github.ahatem.qtranslate.core.main.domain.usecase
+
+import com.github.ahatem.qtranslate.api.core.Logger
+import com.github.ahatem.qtranslate.api.dictionary.Definition
+import com.github.ahatem.qtranslate.api.dictionary.DictionaryEntry
+import com.github.ahatem.qtranslate.api.dictionary.DictionaryRequest
+import com.github.ahatem.qtranslate.api.dictionary.DictionaryResponse
+import com.github.ahatem.qtranslate.api.dictionary.LanguageSwitchDictionary
+import com.github.ahatem.qtranslate.api.language.LanguageCode
+import com.github.ahatem.qtranslate.api.plugin.Service
+import com.github.ahatem.qtranslate.api.plugin.ServiceError
+import com.github.ahatem.qtranslate.api.plugin.SupportedLanguages
+import com.github.ahatem.qtranslate.core.main.mvi.MainState
+import com.github.ahatem.qtranslate.core.settings.data.ActiveServiceManager
+import com.github.ahatem.qtranslate.core.settings.data.Configuration
+import com.github.ahatem.qtranslate.core.shared.logging.LoggerFactory
+import com.github.michaelbull.result.Err
+import com.github.michaelbull.result.Ok
+import com.github.michaelbull.result.Result
+import kotlinx.coroutines.CompletableDeferred
+import kotlinx.coroutines.CoroutineScope
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.delay
+import kotlinx.coroutines.runBlocking
+import kotlinx.coroutines.withTimeout
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlin.test.Test
+import kotlin.test.assertEquals
+import kotlin.test.assertTrue
+
+/**
+ * The dictionary's language switch is only useful if an automatic lookup picks the edition the
+ * word belongs to, an explicit pick is obeyed, and a missing article in one edition falls through
+ * to the next rather than being reported as "not found".
+ */
+class LookupWordUseCaseTest {
+
+    @Test
+    fun `a Cyrillic word opens the Russian edition even when the source says English`() = runBlocking {
+        val dictionary = RecordingDictionary(
+            entries = mapOf(
+                LanguageCode.RUSSIAN to "Слово",
+                LanguageCode.ENGLISH to "Word"
+            )
+        )
+        val state = MutableStateFlow(MainState())
+
+        lookup(dictionary, state, word = "слово", language = LanguageCode.ENGLISH)
+
+        assertEquals(listOf(LanguageCode.RUSSIAN), dictionary.requests)
+        assertEquals(LanguageCode.RUSSIAN, state.value.dictionaryLanguage)
+        assertEquals("Слово", state.value.dictionaryEntries.single().word)
+    }
+
+    @Test
+    fun `an explicit edition pick is obeyed for the same word`() = runBlocking {
+        val dictionary = RecordingDictionary(
+            entries = mapOf(
+                LanguageCode.RUSSIAN to "Слово",
+                LanguageCode.ENGLISH to "Word"
+            )
+        )
+        val state = MutableStateFlow(MainState())
+
+        lookup(
+            dictionary,
+            state,
+            word = "слово",
+            language = LanguageCode.ENGLISH,
+            explicitLanguage = true
+        )
+
+        assertEquals(listOf(LanguageCode.ENGLISH), dictionary.requests)
+        assertEquals(LanguageCode.ENGLISH, state.value.dictionaryLanguage)
+        assertEquals("Word", state.value.dictionaryEntries.single().word)
+    }
+
+    @Test
+    fun `an edition without an article falls through to the one that has it`() = runBlocking {
+        val dictionary = RecordingDictionary(
+            entries = mapOf(LanguageCode.ENGLISH to "Word")
+        )
+        val state = MutableStateFlow(MainState())
+
+        lookup(
+            dictionary,
+            state,
+            word = "слово",
+            language = LanguageCode.RUSSIAN,
+            explicitLanguage = true
+        )
+
+        assertEquals(listOf(LanguageCode.RUSSIAN, LanguageCode.ENGLISH), dictionary.requests)
+        assertEquals(LanguageCode.ENGLISH, state.value.dictionaryLanguage)
+        assertEquals("Word", state.value.dictionaryEntries.single().word)
+    }
+
+    @Test
+    fun `suggestions in one edition do not hide an article in the other`() = runBlocking {
+        val dictionary = RecordingDictionary(
+            entries = mapOf(LanguageCode.ENGLISH to "Session"),
+            suggestions = mapOf(LanguageCode.RUSSIAN to listOf("Сессия"))
+        )
+        val state = MutableStateFlow(MainState())
+
+        lookup(
+            dictionary,
+            state,
+            word = "сессии",
+            language = LanguageCode.RUSSIAN,
+            explicitLanguage = true
+        )
+
+        assertEquals(listOf(LanguageCode.RUSSIAN, LanguageCode.ENGLISH), dictionary.requests)
+        assertEquals("Session", state.value.dictionaryEntries.single().word)
+        assertEquals(LanguageCode.ENGLISH, state.value.dictionaryLanguage)
+    }
+
+    @Test
+    fun `when neither edition has an article the preferred suggestions are shown`() = runBlocking {
+        val dictionary = RecordingDictionary(
+            entries = emptyMap(),
+            suggestions = mapOf(
+                LanguageCode.RUSSIAN to listOf("Сессия"),
+                LanguageCode.ENGLISH to listOf("Session")
+            )
+        )
+        val state = MutableStateFlow(MainState())
+
+        lookup(
+            dictionary,
+            state,
+            word = "сессии",
+            language = LanguageCode.RUSSIAN,
+            explicitLanguage = true
+        )
+
+        assertEquals(listOf(LanguageCode.RUSSIAN, LanguageCode.ENGLISH), dictionary.requests)
+        val entry = state.value.dictionaryEntries.single()
+        assertEquals("did_you_mean", entry.partOfSpeech)
+        assertEquals(listOf("Сессия"), entry.definitions.map { it.text })
+        assertEquals(LanguageCode.RUSSIAN, state.value.dictionaryLanguage)
+    }
+
+    @Test
+    fun `when neither edition has the word the state is not found rather than failed`() = runBlocking {
+        val dictionary = RecordingDictionary(entries = emptyMap())
+        val state = MutableStateFlow(MainState())
+
+        lookup(
+            dictionary,
+            state,
+            word = "несуществующееслово",
+            language = LanguageCode.RUSSIAN
+        )
+
+        assertEquals(listOf(LanguageCode.RUSSIAN, LanguageCode.ENGLISH), dictionary.requests)
+        assertTrue(state.value.dictionaryEntries.isEmpty())
+        assertEquals(false, state.value.dictionaryFailed)
+        assertEquals(LanguageCode.RUSSIAN, state.value.dictionaryLanguage)
+    }
+
+    private suspend fun lookup(
+        dictionary: RecordingDictionary,
+        state: MutableStateFlow<MainState>,
+        word: String,
+        language: LanguageCode,
+        explicitLanguage: Boolean = false
+    ) {
+        val useCase = LookupWordUseCase(
+            scope = CoroutineScope(Dispatchers.Default),
+            activeServiceManager = ActiveServiceManager(
+                activeServices = MutableStateFlow(mapOf("fake:default:dictionary" to dictionary)),
+                configuration = MutableStateFlow(Configuration.DEFAULT)
+            ),
+            loggerFactory = SilentLoggerFactory
+        )
+
+        val finished = CompletableDeferred<Unit>()
+        useCase(
+            word = word,
+            language = language,
+            explicitLanguage = explicitLanguage,
+            updateState = { transform -> state.value = state.value.transform() },
+            onStatusUpdate = { _, _, isFinal -> if (isFinal) finished.complete(Unit) }
+        )
+
+        withTimeout(5_000) {
+            finished.await()
+            // The status callback fires immediately before the state update that clears loading.
+            while (state.value.isDictionaryLoading) delay(5)
+        }
+    }
+
+    private class RecordingDictionary(
+        private val entries: Map<LanguageCode, String>,
+        private val suggestions: Map<LanguageCode, List<String>> = emptyMap(),
+    ) : LanguageSwitchDictionary {
+        override val key = "dictionary"
+        override val name = "Fake Wikipedia"
+        override val version = "1.0.0"
+        override val supportedLanguages = SupportedLanguages.All
+        override val switchLanguages = listOf(LanguageCode.RUSSIAN, LanguageCode.ENGLISH)
+
+        val requests = mutableListOf<LanguageCode>()
+
+        override suspend fun lookup(request: DictionaryRequest): Result<DictionaryResponse, ServiceError> {
+            requests += request.language
+            val text = entries[request.language]
+            if (text != null) {
+                return Ok(
+                    DictionaryResponse(
+                        listOf(
+                            DictionaryEntry(
+                                word = text,
+                                partOfSpeech = "encyclopedia",
+                                definitions = listOf(Definition(text))
+                            )
+                        )
+                    )
+                )
+            }
+            val titles = suggestions[request.language].orEmpty()
+            if (titles.isEmpty()) return Ok(DictionaryResponse(emptyList()))
+            return Ok(
+                DictionaryResponse(
+                    listOf(
+                        DictionaryEntry(
+                            word = request.word,
+                            partOfSpeech = "did_you_mean",
+                            definitions = titles.map(::Definition)
+                        )
+                    )
+                )
+            )
+        }
+    }
+
+    private object SilentLoggerFactory : LoggerFactory {
+        override fun getLogger(name: String): Logger = object : Logger {
+            override fun debug(message: String) = Unit
+            override fun info(message: String) = Unit
+            override fun warn(message: String) = Unit
+            override fun error(message: String, error: Throwable?) = Unit
+        }
+    }
+}
